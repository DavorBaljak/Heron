# Copy this file to .env and fill in your Anthropic API key.
# (scripts/install.sh and scripts/install.ps1 do this for you interactively.)

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# LOXONE_HOST/USER/PASSWORD are NOT set here. For a real Loxone Miniserver,
# they're entered through the interactive setup flow (packages/agent/src/setup.ts,
# run via the install script or `docker compose run --rm heron-agent node
# packages/agent/dist/setup.js`) and saved to a local, gitignored file instead —
# never through this .env.
